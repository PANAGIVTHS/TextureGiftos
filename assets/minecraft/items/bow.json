{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:use_duration",
      "scale": 0.05,
      "entries": [
        {
          "threshold": 0.65,
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:component",
            "component": "minecraft:custom_name",
            "cases": [
              {
                "when": "Elite Power Bow",
                "model": {
                  "type": "minecraft:model",
                  "model": "mcd:item/bows/elite_power_bow_pulling_1"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/bow_pulling_1"
            }
          }
        },
        {
          "threshold": 0.9,
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:component",
            "component": "minecraft:custom_name",
            "cases": [
              {
                "when": "Elite Power Bow",
                "model": {
                  "type": "minecraft:model",
                  "model": "mcd:item/bows/elite_power_bow_pulling_2"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/bow_pulling_2"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "minecraft:custom_name",
        "cases": [
          {
            "when": "Elite Power Bow",
            "model": {
              "type": "minecraft:model",
              "model": "mcd:item/bows/elite_power_bow_pulling_0"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "minecraft:item/bow_pulling_0"
        }
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
          "when": "Elite Power Bow",
          "model": {
            "type": "minecraft:model",
            "model": "mcd:item/bows/elite_power_bow"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/bow"
      }
    }
  }
}